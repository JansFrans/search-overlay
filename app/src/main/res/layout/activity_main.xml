<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#0d0d1a">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEARCH OVERLAY"
        android:textSize="28sp"
        android:textColor="#00e5ff"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OCR + Google Search"
        android:textSize="14sp"
        android:textColor="#888"
        android:layout_marginBottom="32dp"/>
    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="1. Grant Overlay Permission"
        android:backgroundTint="#1a1a2e"
        android:textColor="#fff"
        android:layout_marginBottom="12dp"/>
    <Button
        android:id="@+id/btnCapture"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="2. Grant Screen Capture"
        android:backgroundTint="#1a1a2e"
        android:textColor="#fff"
        android:layout_marginBottom="12dp"/>
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="3. START"
        android:backgroundTint="#00e5ff"
        android:textColor="#000"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: idle"
        android:textColor="#aaa"
        android:layout_marginTop="24dp"/>
</LinearLayout>
